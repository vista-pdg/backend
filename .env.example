GEMINI_API_KEY=your_api_key_here
GEMINI_API_MODEL=gemini-2.0-flash

# Alternativa a la clave: Vertex AI con credenciales de Google Cloud (gcloud auth application-default login)
# GEMINI_VERTEX=true
# GEMINI_PROJECT=mi-proyecto
# GEMINI_LOCATION=global

# Verificación obligatoria de nuevas altas: ver docs/email-verification.md.
# Gmail dedicado + contraseña de aplicación (nunca la contraseña normal).
# Mientras no se configure SMTP, login existente funciona y registro nuevo devuelve 503.
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Generar localmente: openssl rand -hex 32. No reutilizar JWT_SECRET.
VERIFICATION_HASH_SECRET=dev-only-verification-secret-change-before-production
